# Supabase project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Email (Resend SMTP). SMTP_USER is literally "resend"; SMTP_PASS is a Resend API key.
# Leave SMTP_PASS empty in development to print emails to the server log instead.
SMTP_USER=resend
SMTP_PASS=
EMAIL_FROM="Family Secret Santa <santa@bassl.xyz>"
# Defaults shown; only change these to use another provider
# (for Gmail: smtp.gmail.com, SMTP_USER = the Gmail address, SMTP_PASS = an app password).
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465

# Who may start a group (comma-separated emails). Required in production;
# everyone else can only join groups they were added to.
ORGANIZER_EMAILS=

# Claude API key for gift ideas (server only). Leave empty to turn gift ideas off.
ANTHROPIC_API_KEY=

# Public URL of the app, used in email links
APP_URL=http://localhost:3000
# Production: https://bassl.xyz

# Protects /api/cron/notify (Vercel sends it automatically when set)
CRON_SECRET=
