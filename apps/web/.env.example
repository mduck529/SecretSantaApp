# Supabase project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Email (Gmail SMTP). SMTP_PASS is a Google app password, not the account password.
# Leave SMTP_PASS empty in development to print emails to the server log instead.
SMTP_USER=secretsanta8@gmail.com
SMTP_PASS=
EMAIL_FROM="Family Secret Santa <secretsanta8@gmail.com>"
# Defaults shown; only change these to use another provider.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Public URL of the app, used in email links
APP_URL=http://localhost:3000

# Protects /api/cron/notify (Vercel sends it automatically when set)
CRON_SECRET=
